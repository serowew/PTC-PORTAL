# =====================================================
# SERVER
# =====================================================

PORT=3000
NODE_ENV=development

# =====================================================
# DATABASE
# =====================================================

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=databaseforptc1

# =====================================================
# JWT
# =====================================================

JWT_SECRET=your_jwt_secret_here

# =====================================================
# EMAIL / SMTP
# =====================================================

EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASS=

# =====================================================
# DEVELOPMENT
# =====================================================

ALLOW_DEV_LOGIN=true


# Grading system rollout
# Keep disabled until backend validation is complete.

GRADEBOOK_INITIALIZATION_ENABLED=false
GRADEBOOK_ASSESSMENT_WRITES_ENABLED=true
GRADEBOOK_SCORE_WRITES_ENABLED=false
GRADEBOOK_ATTENDANCE_WRITES_ENABLED=false

# Combined semester grading
GRADEBOOK_COMBINED_SUBMISSION_WRITES_ENABLED=false
GRADEBOOK_COMBINED_APPROVAL_WRITES_ENABLED=false
GRADEBOOK_COMBINED_PUBLICATION_WRITES_ENABLED=false
GRADEBOOK_COMBINED_SPECIAL_APPROVAL_ENABLED=false
GRADEBOOK_COMBINED_SPECIAL_OUTCOME_WRITES_ENABLED=false
GRADEBOOK_SPECIAL_RESUBMISSION_APPROVAL_ENABLED=false

# INC lifecycle
GRADEBOOK_MODERN_INC_CLAIM_WRITES_ENABLED=false
GRADEBOOK_MODERN_INC_CONVERSION_WRITES_ENABLED=false
GRADEBOOK_MODERN_INC_EXPIRY_WRITES_ENABLED=false
GRADEBOOK_MODERN_INC_SCORE_WRITES_ENABLED=false
GRADEBOOK_MODERN_INC_SOURCE_WRITE_SCOPE_ENABLED=false

# Official grade sheets
GRADEBOOK_OFFICIAL_SHEET_RECORD_WRITES_ENABLED=false
GRADEBOOK_OFFICIAL_SHEET_VERIFY_WRITES_ENABLED=false
GRADEBOOK_OFFICIAL_SHEET_FINALIZATION_WRITES_ENABLED=false
